# Server
PORT=3000
BASE_URL=http://localhost:3000

# Shop info
SHOP_NAME=My Coffee Shop
SHOP_LOGO_TEXT=☕

# Loyalty rules
DRINKS_REQUIRED=6

# Security
JWT_SECRET=change-me-to-a-long-random-string
BARISTA_PIN=1234

# Apple Wallet (optional — leave blank to disable)
APPLE_PASS_TYPE_ID=pass.com.example.coffee
APPLE_TEAM_ID=ABCDE12345
APPLE_CERT_PATH=./certs/signerCert.pem
APPLE_KEY_PATH=./certs/signerKey.pem
APPLE_KEY_PASSPHRASE=
APPLE_WWDR_PATH=./certs/wwdr.pem

# Google Wallet (optional — leave blank to disable)
GOOGLE_ISSUER_ID=
GOOGLE_CLASS_ID=coffee_loyalty_class
GOOGLE_SERVICE_ACCOUNT_JSON=./certs/google-service-account.json
