# Server
PORT=3000
BASE_URL=http://localhost:3000

# Shop info
SHOP_NAME=My Coffee Shop
SHOP_LOGO_TEXT=☕

# Loyalty rules
DRINKS_REQUIRED=6

# Security
JWT_SECRET=change-me-to-a-long-random-string

# Staff (comma-separated "+968XXXXXXXX:Name" entries).
# Baristas log in from their own phone; they'll receive a 6-digit OTP.
# You can edit this list any time and restart — entries are upserted.
BARISTA_PHONES=+96891234567:Ahmed,+96899887766:Sara

# Owners — same format. Can do everything a barista can AND see the
# dashboard at /dashboard.html. A number appearing in both lists is
# upgraded to owner.
OWNER_PHONES=+96890000000:The Boss

# SMS delivery for the OTP. If not set, the code is printed to the server
# console (fine for the very first setup). Otherwise POSTs {phone, message}
# JSON to the webhook, so you can plug in any provider or a WhatsApp bot.
SMS_WEBHOOK_URL=
SMS_WEBHOOK_SECRET=

# Apple Wallet (optional — leave blank to disable)
APPLE_PASS_TYPE_ID=pass.com.example.coffee
APPLE_TEAM_ID=ABCDE12345
APPLE_CERT_PATH=./certs/signerCert.pem
APPLE_KEY_PATH=./certs/signerKey.pem
APPLE_KEY_PASSPHRASE=
APPLE_WWDR_PATH=./certs/wwdr.pem

# Google Wallet (optional — leave blank to disable)
GOOGLE_ISSUER_ID=
GOOGLE_CLASS_ID=coffee_loyalty_class
GOOGLE_SERVICE_ACCOUNT_JSON=./certs/google-service-account.json
